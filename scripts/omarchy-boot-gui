#!/usr/bin/env python3
"""
omarchy-boot-gui — Libadwaita / GTK4 GUI for Omarchy Boot & Secure Boot Manager.
Provides an intuitive, friendly wizard for Windows dual-booters,
setting up sbctl with Microsoft anti-cheat preservation, and quick reboot controls.
"""

import sys
import os
import shutil
import subprocess
from pathlib import Path

# Add core to sys.path
SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gio, GLib, GObject, Pango

from core.boot_detector import (
    get_firmware_info,
    get_secure_boot_status,
    get_hardware_info,
    get_windows_partitions,
    get_efi_boot_entries
)
from core.limine_manager import (
    read_limine_config,
    has_windows_chainload,
    add_windows_to_limine
)
from core.secureboot_manager import (
    check_sbctl_installed,
    get_sbctl_status,
    generate_setup_commands
)


class BootApp(Adw.Application):
    __gtype_name__ = "OmarchyBootApp"

    def __init__(self):
        super().__init__(
            application_id="org.omarchy.bootmanager",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = BootWindow(application=self)
        win.present()


class BootWindow(Adw.ApplicationWindow):
    __gtype_name__ = "OmarchyBootWindow"

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_title("Omarchy Boot and Secure Boot Manager")
        self.set_default_size(860, 720)

        self.setup_ui()
        self.refresh_state()

    def setup_ui(self):
        toolbar_view = Adw.ToolbarView()
        self.set_content(toolbar_view)

        # Header Bar
        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)

        # Quick Reboot Buttons in Header
        reboot_win_btn = Gtk.Button(label="Reboot to Windows")
        reboot_win_btn.set_tooltip_text("Sets next one-shot boot to Windows and restarts")
        reboot_win_btn.add_css_class("suggested-action")
        reboot_win_btn.connect("clicked", self.on_reboot_windows)
        header.pack_end(reboot_win_btn)

        reboot_bios_btn = Gtk.Button(label="Reboot to BIOS")
        reboot_bios_btn.set_tooltip_text("Restarts directly into UEFI / BIOS Setup")
        reboot_bios_btn.connect("clicked", self.on_reboot_bios)
        header.pack_end(reboot_bios_btn)

        # View Switcher Bar & Stack
        self.view_stack = Adw.ViewStack()
        self.view_stack.set_vexpand(True)
        self.view_stack.set_hexpand(True)

        view_switcher_title = Adw.ViewSwitcherTitle(
            title="Boot and Secure Boot",
            subtitle="Windows Dual-Boot and Anti-Cheat Setup",
            stack=self.view_stack
        )
        header.set_title_widget(view_switcher_title)

        view_switcher_bar = Adw.ViewSwitcherBar(stack=self.view_stack)
        view_switcher_title.bind_property(
            "title-visible",
            view_switcher_bar,
            "reveal",
            GObject.BindingFlags.SYNC_CREATE
        )
        toolbar_view.add_bottom_bar(view_switcher_bar)
        toolbar_view.set_content(self.view_stack)

        # Page 1: Dashboard
        self.dashboard_page = self.build_dashboard_page()
        self.view_stack.add_titled_with_icon(
            self.dashboard_page,
            "dashboard",
            "Overview",
            "computer-symbolic"
        )

        # Page 2: Secure Boot Wizard
        self.wizard_page = self.build_wizard_page()
        self.view_stack.add_titled_with_icon(
            self.wizard_page,
            "wizard",
            "Secure Boot Wizard",
            "security-high-symbolic"
        )

        # Page 3: Limine & Dual-Boot
        self.limine_page = self.build_limine_page()
        self.view_stack.add_titled_with_icon(
            self.limine_page,
            "limine",
            "Limine Dual-Boot",
            "drive-multidisk-symbolic"
        )

    def build_dashboard_page(self) -> Gtk.Widget:
        page = Adw.PreferencesPage()

        # System Status Group
        self.status_group = Adw.PreferencesGroup(
            title="System Security and Boot Status",
            description="Hardware state and active anti-cheat readiness"
        )
        page.add(self.status_group)

        self.row_sb = Adw.ActionRow(title="Secure Boot Status")
        self.sb_badge = Gtk.Label()
        self.sb_badge.add_css_class("pill")
        self.row_sb.add_suffix(self.sb_badge)
        self.status_group.add(self.row_sb)

        self.row_board = Adw.ActionRow(title="Motherboard and Firmware")
        self.board_label = Gtk.Label()
        self.row_board.add_suffix(self.board_label)
        self.status_group.add(self.row_board)

        self.row_sbctl = Adw.ActionRow(title="sbctl Key Manager")
        self.sbctl_label = Gtk.Label()
        self.row_sbctl.add_suffix(self.sbctl_label)
        self.status_group.add(self.row_sbctl)

        # Windows Dual-Boot Group
        self.win_group = Adw.PreferencesGroup(
            title="Windows 11 Dual-Boot Integration",
            description="Status of Windows partition detection and Limine chainload"
        )
        page.add(self.win_group)

        self.row_win_detected = Adw.ActionRow(title="Windows Installation")
        self.win_detected_label = Gtk.Label()
        self.row_win_detected.add_suffix(self.win_detected_label)
        self.win_group.add(self.row_win_detected)

        self.row_win_guid = Adw.ActionRow(title="EFI Partition GUID")
        self.win_guid_label = Gtk.Label()
        self.win_guid_label.set_selectable(True)
        self.row_win_guid.add_suffix(self.win_guid_label)
        self.win_group.add(self.row_win_guid)

        self.row_limine_status = Adw.ActionRow(title="Limine Windows Entry")
        self.limine_status_label = Gtk.Label()
        self.limine_status_label.add_css_class("pill")
        self.row_limine_status.add_suffix(self.limine_status_label)
        self.win_group.add(self.row_limine_status)

        # Quick Actions Group on Dashboard
        actions_group = Adw.PreferencesGroup(
            title="Quick Boot and Setup Actions",
            description="Fast shortcuts for restarting or configuring your system"
        )
        page.add(actions_group)

        row_act_win = Adw.ActionRow(
            title="Reboot into Windows",
            subtitle="Restarts once into Windows Boot Manager (next boot returns to Omarchy)"
        )
        btn_act_win = Gtk.Button(label="Reboot to Windows")
        btn_act_win.add_css_class("suggested-action")
        btn_act_win.connect("clicked", self.on_reboot_windows)
        row_act_win.add_suffix(btn_act_win)
        actions_group.add(row_act_win)

        row_act_bios = Adw.ActionRow(
            title="Reboot into UEFI / BIOS Setup",
            subtitle="Restarts directly into motherboard firmware settings"
        )
        btn_act_bios = Gtk.Button(label="Reboot to BIOS")
        btn_act_bios.connect("clicked", self.on_reboot_bios)
        row_act_bios.add_suffix(btn_act_bios)
        actions_group.add(row_act_bios)

        row_act_wiz = Adw.ActionRow(
            title="Secure Boot Signing Wizard",
            subtitle="Walks through enrolling custom keys with Microsoft anti-cheat support"
        )
        btn_act_wiz = Gtk.Button(label="Open Wizard")
        btn_act_wiz.connect("clicked", lambda b: self.view_stack.set_visible_child_name("wizard"))
        row_act_wiz.add_suffix(btn_act_wiz)
        actions_group.add(row_act_wiz)

        return page

    def build_wizard_page(self) -> Gtk.Widget:
        page = Adw.PreferencesPage()

        intro_group = Adw.PreferencesGroup(
            title="How It Works: Zero-BIOS Secure Boot",
            description="Anti-cheat games (Valorant, EAC, FACEIT) require Secure Boot in Windows. "
                        "By enrolling your own keys while preserving Microsoft OEM keys (-m), "
                        "both Windows and Omarchy boot with Secure Boot permanently enabled 24/7."
        )
        page.add(intro_group)

        # Step 1
        step1_group = Adw.PreferencesGroup(
            title="Step 1: Put Motherboard into Setup Mode",
            description="Your motherboard must be placed into Setup Mode (clearing existing PK keys) once to allow enrolling custom keys."
        )
        page.add(step1_group)

        self.step1_guide_row = Adw.ExpanderRow(
            title="View Motherboard Guide",
            subtitle="Vendor-specific BIOS instructions"
        )
        step1_group.add(self.step1_guide_row)

        guide_row = Adw.PreferencesRow()
        guide_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        guide_box.set_margin_top(12)
        guide_box.set_margin_bottom(12)
        guide_box.set_margin_start(16)
        guide_box.set_margin_end(16)

        self.step1_instructions = Gtk.Label(xalign=0)
        self.step1_instructions.set_wrap(True)
        self.step1_instructions.set_selectable(True)
        guide_box.append(self.step1_instructions)
        guide_row.set_child(guide_box)
        self.step1_guide_row.add_row(guide_row)

        bios_btn_row = Adw.ActionRow(
            title="Enter UEFI / BIOS Setup",
            subtitle="Reboot directly into firmware settings without pressing hotkeys"
        )
        btn_fw = Gtk.Button(label="Reboot to BIOS")
        btn_fw.connect("clicked", self.on_reboot_bios)
        bios_btn_row.add_suffix(btn_fw)
        step1_group.add(bios_btn_row)

        # Step 2
        step2_group = Adw.PreferencesGroup(
            title="Step 2: Enroll Custom Keys and Sign Bootloaders",
            description="Generates your master keys, enrolls them with Microsoft OEM keys, and signs Limine and kernel UKIs."
        )
        page.add(step2_group)

        run_wizard_row = Adw.ActionRow(
            title="Launch Automated Signing Wizard",
            subtitle="Runs 'sbctl create-keys', 'enroll-keys -m', and signs /boot/EFI/"
        )
        btn_run_wizard = Gtk.Button(label="Run Wizard")
        btn_run_wizard.add_css_class("suggested-action")
        btn_run_wizard.connect("clicked", self.on_run_cli_wizard)
        run_wizard_row.add_suffix(btn_run_wizard)
        step2_group.add(run_wizard_row)

        # Step 3
        step3_group = Adw.PreferencesGroup(
            title="Step 3: Turn Secure Boot ON in BIOS",
            description="Once files are signed, return to your BIOS and turn Secure Boot to Enabled. Windows and Omarchy will boot without toggling settings ever again."
        )
        page.add(step3_group)

        # Status row shown after wizard completes
        self.step3_status_row = Adw.ActionRow(
            title="✅ Keys Enrolled — Bootloaders Signed",
            subtitle="Your system is ready. Go to BIOS and enable Secure Boot to finish.",
        )
        self.step3_status_row.add_css_class("success")
        btn_reboot_bios2 = Gtk.Button(label="Reboot to BIOS Now")
        btn_reboot_bios2.add_css_class("suggested-action")
        btn_reboot_bios2.connect("clicked", self.on_reboot_bios)
        self.step3_status_row.add_suffix(btn_reboot_bios2)
        self.step3_status_row.set_visible(False)
        step3_group.add(self.step3_status_row)

        return page

    def build_limine_page(self) -> Gtk.Widget:
        page = Adw.PreferencesPage()

        cfg_group = Adw.PreferencesGroup(
            title="Limine Windows Chainloading",
            description="Enables launching Windows directly from the Limine boot menu on startup."
        )
        page.add(cfg_group)

        self.btn_add_win = Gtk.Button(label="Add Windows to Limine")
        self.btn_add_win.add_css_class("suggested-action")
        self.btn_add_win.connect("clicked", self.on_add_windows_to_limine)

        self.limine_action_row = Adw.ActionRow(
            title="Configure Windows in /boot/limine.conf",
            subtitle="Automatically injects chainload entry using the detected ESP partition GUID"
        )
        self.limine_action_row.add_suffix(self.btn_add_win)
        cfg_group.add(self.limine_action_row)

        # Code preview
        preview_group = Adw.PreferencesGroup(
            title="Generated Entry Preview",
            description="The exact configuration syntax written to /boot/limine.conf"
        )
        page.add(preview_group)

        preview_row = Adw.PreferencesRow()
        preview_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        preview_box.set_margin_top(12)
        preview_box.set_margin_bottom(12)
        preview_box.set_margin_start(16)
        preview_box.set_margin_end(16)

        self.limine_preview = Gtk.Label(xalign=0)
        self.limine_preview.set_wrap(True)
        self.limine_preview.set_selectable(True)
        self.limine_preview.add_css_class("monospace")
        preview_box.append(self.limine_preview)
        preview_row.set_child(preview_box)
        preview_group.add(preview_row)

        return page

    def refresh_state(self):
        """Refreshes hardware and boot status."""
        fw = get_firmware_info()
        hw = fw["hardware"]
        sb = fw["secure_boot"]
        win = fw["windows_partitions"]
        guide = hw["guide"]

        # Motherboard label
        self.board_label.set_text(f"{hw['vendor']} ({hw['model']})")

        # Secure boot badge
        status_code = sb.get("status_code", "")
        signed_count = sb.get("signed_count", 0)

        if sb["enabled"]:
            self.sb_badge.set_text("Enabled and Active")
            self.sb_badge.remove_css_class("warning")
            self.sb_badge.remove_css_class("error")
            self.sb_badge.add_css_class("success")
            self.row_sb.set_subtitle("Anti-cheat games and Windows run smoothly")
            self.step3_status_row.set_visible(False)
        elif status_code == "enrolled_pending_reboot":
            self.sb_badge.set_text("Ready to Activate")
            self.sb_badge.remove_css_class("warning")
            self.sb_badge.remove_css_class("error")
            self.sb_badge.add_css_class("success")
            self.row_sb.set_subtitle(
                f"Keys enrolled, {signed_count} file(s) signed — Reboot to BIOS and enable Secure Boot"
            )
            self.step3_status_row.set_visible(True)
        elif sb["setup_mode"]:
            self.sb_badge.set_text("Setup Mode")
            self.sb_badge.remove_css_class("success")
            self.sb_badge.remove_css_class("error")
            self.sb_badge.add_css_class("warning")
            self.row_sb.set_subtitle("Motherboard is ready to enroll custom keys via Step 2")
            self.step3_status_row.set_visible(False)
        else:
            self.sb_badge.set_text("Disabled")
            self.sb_badge.remove_css_class("success")
            self.sb_badge.remove_css_class("warning")
            self.sb_badge.add_css_class("error")
            self.row_sb.set_subtitle("Put BIOS into Setup Mode (Step 1) before signing")
            self.step3_status_row.set_visible(False)

        # sbctl status
        sbctl_ok = check_sbctl_installed()
        self.sbctl_label.set_text("Installed" if sbctl_ok else "Not installed (will auto-install)")

        # Windows detection
        if win:
            w = win[0]
            self.win_detected_label.set_text("Detected")
            self.row_win_detected.set_subtitle(w["title"])
            self.win_guid_label.set_text(w["partuuid"])

            # Preview in Limine tab
            preview_text = (
                f"/Windows 11\n"
                f"    comment: Boot Windows Boot Manager\n"
                f"    protocol: efi_chainload\n"
                f"    image_path: guid({w['partuuid']}):/EFI/Microsoft/Boot/bootmgfw.efi"
            )
            self.limine_preview.set_text(preview_text)
        else:
            self.win_detected_label.set_text("Not Found")
            self.win_guid_label.set_text("N/A")
            self.limine_preview.set_text("No Windows EFI partition detected.")

        # Limine check
        limine_cfg = read_limine_config()
        if limine_cfg is not None:
            has_chain = has_windows_chainload(limine_cfg)
            if has_chain:
                self.limine_status_label.set_text("Configured")
                self.limine_status_label.remove_css_class("warning")
                self.limine_status_label.add_css_class("success")
                self.row_limine_status.set_subtitle("Windows chainload entry is in /boot/limine.conf")
                self.btn_add_win.set_label("Already Configured")
                self.btn_add_win.set_sensitive(False)
            else:
                self.limine_status_label.set_text("Not Configured")
                self.limine_status_label.remove_css_class("success")
                self.limine_status_label.add_css_class("warning")
                self.row_limine_status.set_subtitle("Go to the Limine Dual-Boot tab to add the Windows entry")
        else:
            self.limine_status_label.set_text("Not Configured")
            self.limine_status_label.remove_css_class("success")
            self.limine_status_label.add_css_class("warning")
            self.row_limine_status.set_subtitle("Go to the Limine Dual-Boot tab to add the Windows entry")

        # Motherboard guide text
        guide_lines = [
            f"Motherboard Brand: {guide['vendor']}",
            f"BIOS Hotkey: {guide['key']}",
            f"Settings Menu: {guide['menu_path']}\n",
            "Steps to Enter Setup Mode:"
        ]
        for i, step in enumerate(guide["setup_mode_steps"], 1):
            guide_lines.append(f"  {i}. {step}")

        guide_lines.append("\nSteps to Re-enable Secure Boot Afterwards:")
        for i, step in enumerate(guide["enable_steps"], 1):
            guide_lines.append(f"  {i}. {step}")

        self.step1_instructions.set_text("\n".join(guide_lines))
        self.step1_guide_row.set_subtitle(f"Configured for {hw['vendor']}")

    def on_reboot_windows(self, button):
        entries = get_efi_boot_entries()
        win_id = entries.get("windows_id")
        if not win_id:
            dialog = Adw.MessageDialog(
                transient_for=self,
                heading="Windows Not Found",
                body="Windows Boot Manager could not be located in efibootmgr."
            )
            dialog.add_response("ok", "OK")
            dialog.present()
            return

        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Reboot into Windows?",
            body=f"Your PC will restart directly into Windows Boot Manager (Boot{win_id}) for the next boot only."
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reboot", "Reboot Now")
        dialog.set_response_appearance("reboot", Adw.ResponseAppearance.SUGGESTED)

        def on_response(d, response):
            if response == "reboot":
                subprocess.Popen(["omarchy-boot", "reboot", "windows"])

        dialog.connect("response", on_response)
        dialog.present()

    def on_reboot_bios(self, button):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Reboot into UEFI / BIOS Setup?",
            body="Your system will restart directly into the motherboard firmware setup screen."
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reboot", "Reboot to BIOS")
        dialog.set_response_appearance("reboot", Adw.ResponseAppearance.DESTRUCTIVE)

        def on_response(d, response):
            if response == "reboot":
                subprocess.Popen(["omarchy-boot", "reboot", "bios"])

        dialog.connect("response", on_response)
        dialog.present()

    def on_add_windows_to_limine(self, button):
        win = get_windows_partitions()
        if not win:
            return

        ok, msg = add_windows_to_limine(win[0]["partuuid"])
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Limine Configuration",
            body=msg
        )
        dialog.add_response("ok", "OK")
        dialog.present()
        self.refresh_state()

    def on_run_cli_wizard(self, button):
        # Open in terminal emulator
        term_cmd = None
        for term in ["ghostty", "foot", "kitty", "alacritty", "konsole", "gnome-terminal", "xterm"]:
            if shutil.which(term):
                term_cmd = term
                break

        if term_cmd in ("ghostty", "foot", "kitty", "alacritty"):
            subprocess.Popen([term_cmd, "-e", "omarchy-boot", "setup"])
        elif term_cmd:
            subprocess.Popen([term_cmd, "-e", "omarchy-boot setup"])
        elif shutil.which("xdg-terminal-exec"):
            subprocess.Popen(["xdg-terminal-exec", "omarchy-boot", "setup"])
        else:
            subprocess.Popen(["omarchy-boot", "setup"])


def main():
    app = BootApp()
    app.run(sys.argv)


if __name__ == "__main__":
    main()
